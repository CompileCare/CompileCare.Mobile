<!--<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:vm="clr-namespace:Compilecare.Mobile.ViewModels"
             x:Class="Compilecare.Mobile.Views.LoginPage"
             BackgroundColor="#F9FAFB"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:LoginViewModel/>
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="28" Spacing="22" VerticalOptions="Center">

        <Frame WidthRequest="96" HeightRequest="96" CornerRadius="48"
               BackgroundColor="#1976D2" HorizontalOptions="Center" HasShadow="True">
            <Label Text="🏥" FontSize="38" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Frame>

        <Label Text="Welcome to HealthCare" FontSize="26" FontAttributes="Bold"
               HorizontalOptions="Center" TextColor="#1976D2"/>

        --><!-- Mobile Number --><!--
        <inputs:SfTextInputLayout Hint="Mobile Number" ContainerType="Outlined"
                                  FocusedColor="#1976D2" UnfocusedColor="#B0B0B0">
            <Entry Text="{Binding MobileNumber}" Keyboard="Telephone" MaxLength="10" />
        </inputs:SfTextInputLayout>

        --><!-- Send OTP --><!--
        <buttons:SfButton Text="Send OTP"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                          Command="{Binding SendOtpCommand}"
                          HeightRequest="50" CornerRadius="14" TextColor="White" Background="#1976D2" />

        --><!-- OTP Entry (visible after otp sent) --><!--
        <VerticalStackLayout IsVisible="{Binding IsOtpSent}" Spacing="12">
            <inputs:SfTextInputLayout Hint="Enter OTP" ContainerType="Outlined"
                                      FocusedColor="#1976D2" UnfocusedColor="#B0B0B0">
                <Entry Text="{Binding Otp}" Keyboard="Numeric" MaxLength="6" />
            </inputs:SfTextInputLayout>

            <buttons:SfButton Text="Verify & Login"
                              Command="{Binding VerifyOtpCommand}"
                              HeightRequest="50" CornerRadius="14" TextColor="White" Background="#1976D2" />
        </VerticalStackLayout>

        --><!-- Status --><!--
        <Label Text="{Binding Message}" FontSize="13" TextColor="#444"
               HorizontalTextAlignment="Center" Margin="0,8,0,0"/>

        --><!-- Busy --><!--
        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
    </VerticalStackLayout>
</ContentPage>-->